{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "trailingSlash": "never",

  "routes": [
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["dachdecker"]
    }
  ],

  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    },
    "403": {
      "rewrite": "/kein-zugriff.html",
      "statusCode": 403
    }
  },

  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/buch/*", "/fotos/*", "/icons/*", "*.{webp,png,svg,ico,js,css,json,woff2,txt}"]
  },

  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  },

  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".webp": "image/webp"
  }
}
