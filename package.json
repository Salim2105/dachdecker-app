{
  "name": "dachdecker-app",
  "version": "0.8.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run content:check && node scripts/gen-anzahl.mjs",
    "content:check": "node scripts/check-content.mjs",
    "build": "next build",
    "start": "next start -p 3200 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "npm run build && npm start",
    "postbuild": "node scripts/gen-sw.mjs",
    "export": "npm run content:check && node scripts/gen-anzahl.mjs && EXPORT=1 next build && EXPORT=1 node scripts/gen-sw.mjs",
    "desktop:dev": "npm run export && electron .",
    "desktop:build": "npm run export && electron-builder --mac",
    "desktop:build:neu": "npm run export && electron-builder --mac --config electron-builder-neu.yml",
    "ios": "npm run build && node scripts/serve-ios.mjs",
    "deploy": "npm run export && wrangler pages deploy out --project-name=dachdecker --commit-dirty=true"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mathjs": "^15.2.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
